# Telegram token from @BotFather
TELEGRAM_BOT_TOKEN=

# For a personal bot, set this after running /whoami.
# Leave empty only for the first test; otherwise anyone who finds the bot can use it.
ALLOWED_TELEGRAM_USER_ID=

# Calendar/time settings
APP_TIMEZONE=Asia/Tehran
GOOGLE_CALENDAR_ID=primary
GOOGLE_CREDENTIALS_FILE=credentials.json
GOOGLE_TOKEN_FILE=data/google_token.json

# Local storage
DATABASE_FILE=data/voicecal.db

# V1.6 Persian STT: whisper.cpp + Persian fine-tuned base GGML model.
# Run setup_stt_windows.bat once. The default model is about 148 MB.
WHISPER_CPP_EXE=tools/whispercpp/whisper-cli.exe
WHISPER_CPP_MODEL=models/ggml-base-fa.bin
WHISPER_CPP_THREADS=4
WHISPER_CPP_BEAM_SIZE=5
WHISPER_CPP_BEST_OF=5
MAX_VOICE_SECONDS=90

# Defaults used when the user doesn't explicitly say them
DEFAULT_EVENT_DURATION_MINUTES=60
DEFAULT_REMINDER_MINUTES=10
